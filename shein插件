// 在SHEIN页面右下角添加分析按钮
function injectPickerButton() {
  if (document.getElementById('shein-picker-float-btn')) return;
  
  const btn = document.createElement('button');
  btn.id = 'shein-picker-float-btn';
  btn.innerHTML = `
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 3h18v18H3z"></path>
      <path d="M18 8h1a2 2 0 0 1 2 2v1"></path>
      <path d="M3 16h1a2 2 0 0 1 2 2v1"></path>
      <line x1="8" y1="8" x2="16" y2="16"></line>
      <line x1="8" y1="16" x2="16" y2="8"></line>
    </svg>
    <span>分析本页</span>
  `;
  
  btn.addEventListener('click', () => {
    analyzeCurrentPage();
  });
  
  document.body.appendChild(btn);
}

// 分析当前页面商品
function analyzeCurrentPage() {
  const products = [];
  const productElements = document.querySelectorAll('.S-product-item, .product-list__item');
  
  productElements.forEach((el, index) => {
    try {
      const name = el.querySelector('.product-name, .S-product-item__name')?.textContent?.trim() || `商品${index + 1}`;
      const priceText = el.querySelector('.price, .S-product-item__price')?.textContent?.trim() || '0';
      const price = parseFloat(priceText.replace(/[^0-9.]/g, ''));
      const image = el.querySelector('img')?.src || '';
      
      // 模拟销量数据
      const sales = Math.round(Math.random() * 500) + 50;
      
      products.push({
        id: `page_${Date.now()}_${index}`,
        name,
        price,
        image,
        sales,
        revenue: price * sales
      });
    } catch (e) {
      console.error('解析商品失败:', e);
    }
  });
  
  if (products.length > 0) {
    // 发送到后台页面显示
    chrome.runtime.sendMessage({
      action: 'showPageAnalysis',
      data: {
        date: new Date().toISOString().split('T')[0],
        products,
        totalSales: products.reduce((sum, p) => sum + p.revenue, 0),
        totalOrders: products.reduce((sum, p) => sum + p.sales, 0)
      }
    });
  } else {
    alert('未找到商品数据，请确保您在SHEIN的商品列表页');
  }
}

// 页面加载完成后注入按钮
if (document.readyState === 'complete') {
  injectPickerButton();
} else {
  window.addEventListener('load', injectPickerButton);
}

// 监听DOM变化动态注入按钮
const observer = new MutationObserver(() => {
  injectPickerButton();
});

observer.observe(document.body, {
  childList: true,
  subtree: true
});
